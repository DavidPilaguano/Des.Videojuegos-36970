config_version=5

[application]
config/name="Panel de controles"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"

[input]
jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":32)]
}
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":65)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":68)]
}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.10, 0.16, 1)
